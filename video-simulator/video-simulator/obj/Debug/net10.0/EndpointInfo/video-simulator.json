{
  "openapi": "3.1.1",
  "info": {
    "title": "video-simulator | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5002"
    }
  ],
  "paths": {
    "/api/vs/files": {
      "post": {
        "tags": [
          "VideoSimulator"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "$ref": "#/components/schemas/IFormFile"
                  }
                }
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/vs/files/{fileName}": {
      "delete": {
        "tags": [
          "VideoSimulator"
        ],
        "parameters": [
          {
            "name": "fileName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/vs/stream/start": {
      "post": {
        "tags": [
          "VideoSimulator"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartStreamRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/StartStreamRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/StartStreamRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/vs/stream/stop": {
      "post": {
        "tags": [
          "VideoSimulator"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StopStreamRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/StopStreamRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/StopStreamRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "IFormFile": {
        "type": "string",
        "format": "binary"
      },
      "StartStreamRequest": {
        "required": [
          "fileName"
        ],
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string"
          }
        }
      },
      "StopStreamRequest": {
        "required": [
          "streamName"
        ],
        "type": "object",
        "properties": {
          "streamName": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "VideoSimulator"
    }
  ]
}